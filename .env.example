# Copia este archivo como .env y completa los valores. El .env NUNCA se sube al repositorio.

# --- Dominio y aplicación ---
DOMAIN=recetas.tudominio.com
APP_URL=https://recetas.tudominio.com
APP_ENV=production

# --- JWT ---
# Genera una clave con: openssl rand -hex 32
SECRET_KEY=reemplaza-con-una-clave-aleatoria-larga
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL (usa solo letras y números en la contraseña) ---
POSTGRES_USER=recetas
POSTGRES_PASSWORD=reemplaza-esta-contrasena
POSTGRES_DB=recetas
# Solo para ejecutar sin Docker (en Docker Compose se construye automáticamente):
# DATABASE_URL=sqlite:///./recetas.db

# --- LLM (cualquier API compatible con OpenAI) ---
# Groq (gratis): OPENROUTER_BASE_URL=https://api.groq.com/openai/v1 y OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=tu-api-key-de-openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
